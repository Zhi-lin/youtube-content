{
  "name": "youtube-dialogue-article",
  "version": "1.0.0",
  "private": true,
  "description": "YouTube 字幕 → 中文对话文章生成器（Cloudflare Worker + Gemini）",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "marked": "^15.0.6"
  }
}
