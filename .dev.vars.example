# 复制为 .dev.vars 后填入真实值（.dev.vars 不要提交）。
# wrangler dev 会自动加载本文件作为本地 secret。

# Gemini AI Studio 免费 API Key：https://aistudio.google.com/api-keys
GEMINI_API_KEY=your-gemini-api-key

# Webshare 代理（可选）。格式：host:port:username:password
# 注意：Webshare 免费档是 HTTP/1.0 隧道，与 Cloudflare workerd 的 startTls 不兼容，
# 实测字幕抓取握手失败；建议改用下方 Supadata。付费 HTTP/1.1 住宅代理可用。
WEBSHARE_PROXY=

# Supadata 字幕 API key（推荐）。绕过 YouTube 对数据中心 IP 的风控。
# 免费档 100 次/月，无需信用卡：https://supadata.ai
SUPADATA_API_KEY=

# 小米 MiMo 备用模型（可选）。Gemini 失败（如 429 配额）时自动降级到它。
# OpenAI 兼容端点 https://api.xiaomimimo.com/v1/chat/completions
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro
